# Brazil Business Intelligence — backend environment variables
# Copy to .env and fill in real values (never commit .env)

# Single Postgres connection used for both source data (receita DB) and product tables (schema: product).
# On VPS derived from RECEITA_DATABASE_URL by deploy script — never log this value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional Redis URL for rate-limit/cache fast path.
# If absent or unreachable the app falls back to in-memory cache automatically.
REDIS_URL=redis://localhost:6379

# Contact/from address used by the email hook stubs.
CONTACT_EMAIL=contact@ambern.dev

# Runtime environment label (development | staging | production).
API_ENV=development

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=https://brazil.ambern.dev,http://localhost:3100
